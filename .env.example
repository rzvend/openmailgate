AWS_REGION=us-east-1
S3_BUCKET=ricardo-vc-ses-mailbox
S3_INCOMING_PREFIX=incoming/
S3_PROCESSED_PREFIX=processed/
S3_FAILED_PREFIX=failed/
BASE_DIR=/home/ricardo/ses-s3-mailbox
MASTER_MAILDIR=/home/ricardo/ses-s3-mailbox/data/maildir/master
DB_PATH=/home/ricardo/ses-s3-mailbox/data/mailbox.db

SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/ses-s3-mailbox-incoming
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10

# ── Local SMTP server ────────────────────────────────────────────────────
LOCAL_SMTP_HOST=0.0.0.0
LOCAL_SMTP_PORT=2525
LOCAL_SMTP_ALLOWED_NETWORKS=127.0.0.1/32,10.10.10.0/24,100.64.0.0/10

# ── Amazon SES SMTP relay ────────────────────────────────────────────────
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=CHANGE_ME
SES_SMTP_PASSWORD=CHANGE_ME
SES_SMTP_STARTTLS=true

# ── Sender identity ──────────────────────────────────────────────────────
DEFAULT_FROM_DOMAIN=inbox.ricardo.vc

# ── Sent mail storage ────────────────────────────────────────────────────
SENT_MAILDIR=/home/ricardo/ses-s3-mailbox/data/maildir/master/.Sent
