# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=SES S3 Mailbox
APP_VERSION=0.1.0-dev

# required — openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE

# Mail domain for SES receiving/sending
MAIL_DOMAIN=
# From domain for outbound (leave empty to use MAIL_DOMAIN)
DEFAULT_FROM_DOMAIN=
# Optional. Defaults to mail.<MAIL_DOMAIN>
CUSTOM_MAIL_FROM_DOMAIN=

# 127.0.0.1 for local, 0.0.0.0 for LAN/tailnet
API_BIND=127.0.0.1
API_PORT=8000
IMAP_PORT=143
SMTP_PORT=2525

# ── Dovecot ─────────────────────────────────────────────────────────────

# Docker shared users file
DOVECOT_USERS_FILE=/app/dovecot/users
# container internal path
DOVECOT_MAIL_ROOT=/app/data/maildir
# 127.0.0.1 recommended for alpha
IMAP_BIND=127.0.0.1
# 127.0.0.1 recommended for alpha
SMTP_BIND=127.0.0.1

# ── Database and Paths (Docker internal) ─────────────────────────────────
# These are container-internal paths. Do not change unless you know what you're doing.
DB_PATH=/app/data/mailbox.db
MAILDIR_ROOT=/app/data/maildir
RAW_EMAIL_DIR=/app/data/raw-emails
RAW_OUTBOUND_DIR=/app/data/raw-outbound
LOG_DIR=/app/logs

# ── AWS ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# required
AWS_ACCESS_KEY_ID=CHANGE_ME
# required — protect this file
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# optional — leave empty for auto-generated name
S3_BUCKET=
# required — full SQS queue URL
SQS_QUEUE_URL=CHANGE_ME
# optional — queue name for new setups
SQS_QUEUE_NAME=
# optional — SES receipt rule set name
SES_RULE_SET=
# optional — IAM user for SMTP relay
SMTP_IAM_USER=
# auto-generated unique suffix for resource names
RESOURCE_SUFFIX=

S3_INCOMING_PREFIX=incoming/
S3_PROCESSED_PREFIX=processed/
S3_FAILED_PREFIX=failed/

# ── SES SMTP Relay (outbound) ────────────────────────────────────────────
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587

# required
SES_SMTP_USERNAME=CHANGE_ME
# required — protect this file
SES_SMTP_PASSWORD=CHANGE_ME

SES_SMTP_STARTTLS=true
LOCAL_SMTP_HOST=0.0.0.0
LOCAL_SMTP_PORT=2525
LOCAL_SMTP_ALLOWED_NETWORKS=127.0.0.1/32,10.10.10.0/24,100.64.0.0/10

# ── Cloudflare ───────────────────────────────────────────────────────────

# required — protect this file
CLOUDFLARE_API_TOKEN=CHANGE_ME
# required
CLOUDFLARE_ZONE_ID=CHANGE_ME

# ── Terraform / OpenTofu (future setup) ──────────────────────────────────
IAC_TOOL=tofu
IAC_WORKDIR=/app/iac
IAC_STATE_DIR=/app/state/iac
IAC_LOG_DIR=/app/logs/setup

# ── Setup ────────────────────────────────────────────────────────────────
SETUP_ENABLED=true
SETUP_COMPLETED=false
SETUP_ALLOW_WEB_CREDENTIALS=true

# ── Support / About ─────────────────────────────────────────────────────
APP_SUPPORT_URL=
APP_SUPPORT_LABEL=Support
APP_RELEASE_CHANNEL=alpha

# ── SQS ──────────────────────────────────────────────────────────────────
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10

# ── Maildir Sent / Duplicates ────────────────────────────────────────────
SENT_MAILDIR=/app/data/maildir/master/.Sent
SENT_DUPLICATES_MAILDIR=/app/data/maildir/master/.SentDuplicates

# ── Security ─────────────────────────────────────────────────────────────
# Protect this file: chmod 600 .env
# Never commit .env to version control.
# Docker secrets can replace this file in production.
