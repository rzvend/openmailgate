[Unit]
Description=SES S3 Mailbox SQS Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ricardo
WorkingDirectory=/home/ricardo/ses-s3-mailbox
ExecStart=/usr/bin/python3 -m worker.sqs_worker
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
